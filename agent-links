#!/bin/sh
set -eu

script_path="$0"
case "$script_path" in
  */*) ;;
  *) script_path="$(command -v "$script_path")" ;;
esac
script_dir="$(CDPATH= cd -P "$(dirname "$script_path")" && pwd)"

if ! command -v bun >/dev/null 2>&1; then
  printf 'error: Bun is required to run agent-links (https://bun.sh/).\n' >&2
  exit 127
fi

exec bun run "$script_dir/agent-links.ts" "$@"
